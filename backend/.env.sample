# Exoskeleton of .env backend file

# Database Connection (Defaults to SQLite for local development)
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# Groq API Key (Required for LLM features)
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Credentials (Required for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret Key (Used to secure authentication tokens)
SECRET_KEY=your_jwt_secret_key_here

# CORS Allowed Origins (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Qdrant Cloud connection (leaves blank to use local storage)
# QDRANT_URL=your_qdrant_url_here
# QDRANT_API_KEY=your_qdrant_api_key_here
